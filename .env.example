# Copy to .env and fill in real values. Never commit .env.
# Document EVERY variable the app reads, with a safe dummy value.

# APP_ENV: development on a development machine. A real build (NODE_ENV=production) must set it to staging or
# production and refuses to start without it (row 22).
APP_ENV=development
LOG_LEVEL=info
# DATABASE_URL=postgres://localhost:5432/app

# Claude API. Leave the key empty here; set the real value in .env or your secret manager.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Sign-in with an emailed code (row 8, decision 0021). Production refuses to start without all four.
# AUTH_SECRET: a long random string; it keys the hash of every login code.
# AUTH_SECRET=
# Resend: https://resend.com — the key and a sender on a verified domain.
# RESEND_API_KEY=
# MAIL_FROM=OneHub <no-reply@example.test>
# Development only: also append each login code to this file (browser tests read it).
# LOGIN_CODE_OUTBOX=
# The product's own address (row 9d): the sign-in link in every invitation is built from it, never from the request.
# APP_URL bắt buộc ở bản thật: https, absolute, no user or password, no ? or #. Optional on a development machine.
# APP_URL=https://example.test
# Production value (row 22): APP_URL is the host inventory.onehub.center over https (decision 0041). MAIL_FROM must be an address on onehub.center or
# one of its subdomains.

# Row 7c: the app connects as its login role quy_hang_login (migration 008) — it owns nothing and is only a member of
# quy_hang_app, so code inside the query door cannot get back to the table owner. The door refuses an owner connection.
# On a lane: make db-up, apply migrations, make db-login (sets the role's password local-only on the lane's container).
# DATABASE_URL=postgres://quy_hang_login:local-only@127.0.0.1:5560/<database>
# PSQL_LOGIN — only with PSQL set (CI, row 1s): the whole psql command connected as quy_hang_login, for the isolation
# suite's login-session cases, e.g. psql -h 127.0.0.1 -p 5432 -U quy_hang_login (password through PGPASSWORD).
# PSQL_LOGIN=

# Row 1s: `make ci-db` (db/scripts/ci-db.sh) — everything CI runs on a database. DB_PORT is the Postgres port (CI: 5432).
# CI_DB_CONTAINER — only on a machine without psql: the Postgres container psql runs inside (still over TCP).
# CI_DB_CONTAINER=
# CI_DB_OUT — folder for the JSON reports of make ci-db (default: a new temporary folder, printed).
# CI_DB_OUT=
# CI_DB_DOI — seconds make ci-db waits for Postgres to accept connections (default 60).
# CI_DB_DOI=
# NEXT_PUBLIC_E2E_BUTTON_RECORD — browser tests only (row 9b): set to 1 by the signed-in browser suite's dev server so
# the permission button records its decisions on the page for the role × screen suite. Never set in a real build.
# NEXT_PUBLIC_E2E_BUTTON_RECORD=

# Row 22: staging and production targets (make deploy, make rollback). Set these in the shell or CI, never in the app.
# MIGRATE_DATABASE_URL — the table owner's connection, used only by the migration step of `make deploy`. The running app
# must never get it: the query door refuses an owner connection.
# MIGRATE_DATABASE_URL=postgres://postgres@db.example.test:5432/postgres
# LOGIN_DATABASE_URL — the login role's connection on a target (quy_hang_login), for the isolation check after a deploy.
# LOGIN_DATABASE_URL=postgres://quy_hang_login@db.example.test:5432/postgres
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID — used by `make deploy` and `make rollback`. One Vercel project per
# environment, so VERCEL_PROJECT_ID differs between staging and production.
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# Row 22 — isolation check, backup and restore drill on a target (db/scripts/cach-ly-dich.sh, sao-luu.sh, khoi-phuc-thu.sh).
# PSQL_DICH, PG_DUMP_CMD, PG_RESTORE_CMD — the client commands (default psql, pg_dump, pg_restore), e.g. through docker.
# PSQL_DICH=
# PG_DUMP_CMD=
# PG_RESTORE_CMD=
# PG_DUMP_ARGS — extra flags for the dump.
# PG_DUMP_ARGS=
# SAO_LUU_LUOC_DO — schemas to back up and count; on Supabase name ours only, e.g. public identity app.
# SAO_LUU_LUOC_DO=
# KHOI_PHUC_ADMIN_URL, KHOI_PHUC_LOGIN_URL — the server of the restore drill (its database name is replaced by a scratch one).
# KHOI_PHUC_ADMIN_URL=postgres://postgres@db.example.test:5432/postgres
# KHOI_PHUC_LOGIN_URL=postgres://quy_hang_login@db.example.test:5432/postgres
# KHOI_PHUC_GIU — set to 1 to keep the scratch database after the drill.
# KHOI_PHUC_GIU=

# Row 22 — make deploy / rollback / smoke (tools/deploy). Production checks the staging health first at STAGING_APP_URL.
# STAGING_APP_URL=https://staging.example.test
# VERCEL_AUTOMATION_BYPASS_SECRET — only if Vercel deployment protection is on: lets the check reach a new deployment.
# VERCEL_AUTOMATION_BYPASS_SECRET=
# CACH_LY_CMD — the isolation command run by make deploy (default bash db/scripts/cach-ly-dich.sh); tests replace it.
# CACH_LY_CMD=
# DEPLOY_KIEM_PG_CONTAINER — tests only: a lane container to run the real migrate.sh in the deploy suite.
# DEPLOY_KIEM_PG_CONTAINER=

# Row 22 — the commit GET /api/v1/health reports. Vercel sets VERCEL_GIT_COMMIT_SHA on git deploys; make deploy passes
# COMMIT_SHA to a prebuilt deployment. Leave both empty on a development machine (health says "unknown").
# COMMIT_SHA=
# VERCEL_GIT_COMMIT_SHA=
