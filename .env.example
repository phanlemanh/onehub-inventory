# Copy to .env and fill in real values. Never commit .env.
# Document EVERY variable the app reads, with a safe dummy value.

APP_ENV=development
LOG_LEVEL=info
# DATABASE_URL=postgres://localhost:5432/app

# Claude API. Leave the key empty here; set the real value in .env or your secret manager.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Sign-in with an emailed code (row 8, decision 0021). Production refuses to start without all four.
# AUTH_SECRET: a long random string; it keys the hash of every login code.
# AUTH_SECRET=
# Resend: https://resend.com — the key and a sender on a verified domain.
# RESEND_API_KEY=
# MAIL_FROM=OneHub <no-reply@example.test>
# Development only: also append each login code to this file (browser tests read it).
# LOGIN_CODE_OUTBOX=
# The product's own address (row 9d): the sign-in link in every invitation is built from it, never from the request.
# APP_URL bắt buộc ở bản thật: https, absolute, no user or password, no ? or #. Optional on a development machine.
# APP_URL=https://example.test

# Row 7c: the app connects as its login role quy_hang_login (migration 008) — it owns nothing and is only a member of
# quy_hang_app, so code inside the query door cannot get back to the table owner. The door refuses an owner connection.
# On a lane: make db-up, apply migrations, make db-login (sets the role's password local-only on the lane's container).
# DATABASE_URL=postgres://quy_hang_login:local-only@127.0.0.1:5560/<database>
# PSQL_LOGIN — only with PSQL set (CI, row 1s): the whole psql command connected as quy_hang_login, for the isolation
# suite's login-session cases, e.g. psql -h 127.0.0.1 -p 5432 -U quy_hang_login (password through PGPASSWORD).
# PSQL_LOGIN=
