      "headers": {
        "X-Reui-Style": "base-nova",
        "Authorization": "Bearer ${REUI_LICENSE_KEY:-}"
      }
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    }
  }
}
