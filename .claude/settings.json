{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make format)",
      "Bash(make gen)",
      "Bash(make ontology)",
      "Bash(make e2e)",
      "Bash(make build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(npm run build)",
      "Bash(node tools/kit-root.mjs)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Edit(./.github/workflows/**)",
      "Edit(./governance/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git push origin HEAD:main:*)"
    ],
    "ask": [
      "Bash(gh pr merge *--auto*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh pr merge *--squash*)",
      "Bash(gh pr merge *--rebase*)",
      "Bash(gh pr review *--approve*)",
      "Bash(gh release create:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" 2>/dev/null; [ -f Makefile ] && command -v make >/dev/null 2>&1 && make -s derived 2>&1; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")\"/.claude/hooks/guard-edits.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")\"/.claude/hooks/check-changed.sh",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "acceptance-gate@delivery-loop": true,
    "feature-loop@delivery-loop": true,
    "diagram-design@delivery-loop": true,
    "superpowers@claude-plugins-official": true,
    "roadmap@delivery-loop": true,
    "knowledge@delivery-loop": true,
    "dispatch@delivery-loop": true,
    "acceptance-gate@acceptance-gate-kit": false,
    "feature-loop@acceptance-gate-kit": false,
    "diagram-design@acceptance-gate-kit": false,
    "dieu-phoi@acceptance-gate-kit": false,
    "road-map@acceptance-gate-kit": false,
    "tri-thuc@acceptance-gate-kit": false
  },
  "extraKnownMarketplaces": {
    "delivery-loop": {
      "source": {
        "source": "github",
        "repo": "phanlemanh/delivery-loop",
        "ref": "v3.1.1"
      }
    }
  }
}
