{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make format)",
      "Bash(make gen)",
      "Bash(make ontology)",
      "Bash(make e2e)",
      "Bash(make build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Edit(./.github/workflows/**)",
      "Edit(./governance/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git push origin HEAD:main:*)"
    ],
    "ask": ["Bash(gh pr merge:*)", "Bash(gh pr review --approve:*)", "Bash(gh release create:*)"]
  },
  "enabledPlugins": {
    "acceptance-gate@acceptance-gate-kit": true,
    "feature-loop@acceptance-gate-kit": true,
    "diagram-design@acceptance-gate-kit": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "acceptance-gate-kit": {
      "source": {
        "source": "github",
        "repo": "phanlemanh/acceptance-gate-kit"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")\"/.claude/hooks/guard-edits.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")\"/.claude/hooks/check-changed.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
