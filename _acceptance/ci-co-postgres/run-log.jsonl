"{\"ts\":\"2026-11-13T13:02:00Z\",\"sha\":\"6ae164b6b1ecc7d875abc055a46b604fa0715d42\",\"round\":1,\"kind\":\"finding\",\"file\":\".env.example\",\"title\":\"ci-db.sh reads two new environment variables that .env.example does not list (CI_DB_OUT, CI_DB_DOI)\",\"severity\":\"low\",\"source\":\"conventions\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Hai tuỳ chỉnh của lệnh kiểm CI không được ghi trong tệp cấu hình mẫu, nên người mới khó biết chúng tồn tại. Lệnh vẫn chạy đúng với giá trị mặc định.\",\"can_cu\":\"Hậu quả nhẹ, chỉ là thiếu tài liệu, không mất dữ liệu và người dùng cuối không thấy; thêm hai dòng sau này rất rẻ.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-13T13:02:00Z\",\"sha\":\"6ae164b6b1ecc7d875abc055a46b604fa0715d42\",\"round\":1,\"kind\":\"finding\",\"file\":\"db/scripts/ci-thu.sh\",\"title\":\"ci-thu waits for Postgres forever if the container never becomes ready\",\"severity\":\"low\",\"source\":\"bugs\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Nếu bbài dựng lại gặp cơ sở dữ liệu không lên được, lượt chấm sẽ treo thay vì báo đỏ. Người chạy phải tự dừng và thử lại.\",\"can_cu\":\"Chỉ xảy ra khi hạ tầng hỏng, không mất dữ liệu và chạy lại là xong; công cụ này chỉ người trong nhóm dùng, không phải khách hàng.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-13T13:02:00Z\",\"sha\":\"6ae164b6b1ecc7d875abc055a46b604fa0715d42\",\"round\":1,\"kind\":\"finding\",\"file\":\"db/scripts/ci-that.mjs\",\"title\":\"ci-that `--cho` without a number turns into an endless wait\",\"severity\":\"low\",\"source\":\"bugs\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Nếu gõ sai tham số thời gian chờ, lệnh đo CI sẽ chờ mãi thay vì báo lỗi. Cấu hình hiện tại truyền đúng nên không gặp.\",\"can_cu\":\"Chỉ xảy ra khi người chạy gõ sai tay, tự dừng và chạy lại được; cấu hình sẵn đã an toàn nên sửa không đáng công.\",\"proposal\":\"wont-fix\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-13T13:02:00Z\",\"sha\":\"6ae164b6b1ecc7d875abc055a46b604fa0715d42\",\"round\":1,\"kind\":\"finding\",\"file\":\"tests/ci-ban-sao-nong.test.ts\",\"title\":\"Hình dạng 5 (tuyên quét LỚP nhưng chỉ có điểm-case): bài quét lịch sử git bỏ sót lời gọi có thật trong cây\",\"severity\":\"high\",\"source\":\"measurement\",\"inContract\":true,\"acRef\":\"AC-7\",\"plain\":\"\",\"can_cu\":\"\",\"proposal\":\"\",\"khongBacBo\":false,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-13T13:02:00Z\",\"sha\":\"6ae164b6b1ecc7d875abc055a46b604fa0715d42\",\"round\":1,\"kind\":\"finding\",\"file\":\"tests/don-dung-tam.test.ts\",\"title\":\"Hình dạng 5 (thiếu ma trận toàn phần viết trước): E8 ghim '6 loại × 2 cấu hình' nhưng bài chỉ phủ 5 loại trên một gốc\",\"severity\":\"high\",\"source\":\"measurement\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Việc dọn thư mục dựng tạm chỉ được thử đầy đủ trên một trong hai cấu hình trình duyệt. Cấu hình còn lại có thể lỗi mà bài kiểm không phát hiện.\",\"can_cu\":\"Rủi ro là thư mục rác trên máy dãy chứ không phải dữ liệu khách hàng, và lỗi sẽ lộ khi dùng thật; bổ sung ô kiểm sau này không đắt.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-13T13:02:00Z\",\"sha\":\"6ae164b6b1ecc7d875abc055a46b604fa0715d42\",\"round\":1,\"kind\":\"finding\",\"file\":\"tests/don-dung-tam.test.ts\",\"title\":\"Hình dạng 1 (đo CHỈ DẪN thay vì ĐẦU RA): 'hai cau hinh Playwright khai dung ham don' chỉ grep mã nguồn\",\"severity\":\"medium\",\"source\":\"measurement\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Bài kiểm chỉ xác nhận cấu hình có ghi dòng gọi hàm dọn, không xác nhận hàm thật sự chạy. Nếu ai đó làm hỏng bước dọn, bài kiểm vẫn xanh.\",\"can_cu\":\"Hậu quả chỉ là thư mục tạm không được dọn trên máy dãy, không ảnh hưởng người dùng và bài khác vẫn đo hành vi dọn.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-13T13:02:00Z\",\"sha\":\"6ae164b6b1ecc7d875abc055a46b604fa0715d42\",\"round\":1,\"kind\":\"finding\",\"file\":\"tests/fixtures/ci-db/co-phien.json\",\"title\":\"Hình dạng 2 (fixture cắt đúng khuôn bên đọc, không round-trip từ writer): báo cáo Playwright 'thật' chỉ còn đúng các khoá của PwReport\",\"severity\":\"medium\",\"source\":\"measurement\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Phép đếm giao–nhận được thử trên dữ liệu mẫu đã rút gọn, nên nếu công cụ chạy trình duyệt đổi định dạng báo cáo, bài thử không báo trước.\",\"can_cu\":\"Lệnh chạy thật vẫn đọc báo cáo thật nên lỗi sẽ lộ ngay ở CI và chạy lại được; không ảnh hưởng người dùng cuối.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-13T13:02:00Z\",\"sha\":\"6ae164b6b1ecc7d875abc055a46b604fa0715d42\",\"round\":1,\"kind\":\"finding\",\"file\":\"tests/ci-ban-sao-nong.test.ts\",\"title\":\"Hình dạng 3 (assert 'chuỗi có mặt' khi lời hứa là quan hệ): đối chứng 'cach-ly.db.test.ts doc ban chep' chỉ toContain\",\"severity\":\"low\",\"source\":\"measurement\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Bài kiểm chỉ xác nhận chuỗi tên bản chép có trong tệp, chưa xác nhận đường dẫn thật khớp tệp đã ghim. Nếu ai đó đổi lệch, bài kiểm có thể vẫn xanh.\",\"can_cu\":\"Rủi ro thấp vì bài cách ly chạy thật sẽ đỏ nếu tệp thiếu; không mất dữ liệu và sửa lại nhanh khi gặp.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
