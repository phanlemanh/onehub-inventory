{
  "name": "onehub-inventory",
  "version": "0.2.0",
  "description": "SaaS quản lý hàng cho sàn môi giới bất động sản — bản chuẩn hoá của Quỹ hàng (onehub-quy-hang)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-3470}",
    "start": "next start -p 3470",
    "build": "next build",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "git config merge.generated-file.driver true || true"
  },
  "devDependencies": {
